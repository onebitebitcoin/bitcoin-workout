# Redis (Upstash 또는 자체 호스팅)
REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 (백엔드와 동일한 크레덴셜)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Worker 설정
WORKER_CONCURRENCY=1
LOG_LEVEL=INFO

# 동시에 띄우는 worker.py 인스턴스 수 (systemd stackhealth-worker@1, @2 ... 개수와 일치시킬 것)
# cartoon 필터가 job당 내부 프로세스 풀 크기를 정할 때, worker.py가 런타임에 주입하는
# FFMPEG_ACTIVE_JOBS(실시간 활성 잡 수)를 우선 쓰고 이 값은 그게 없을 때만 폴백으로 쓴다 — 수동 튜닝
# 대상 아님, systemd 유닛 개수와만 맞추면 된다.
WORKER_INSTANCES=1
# 동시 처리 가능한 무거운(ffmpeg) job 수 — 보통 WORKER_INSTANCES와 같게 맞춘다.
MAX_FFMPEG_CONCURRENT=2
