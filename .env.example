# Database
DATABASE_URL=sqlite:///./dev.db

# JWT
SECRET_KEY=<generate with: python3 -c "import secrets; print(secrets.token_hex(32))">
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://<bucket>.r2.dev

# Admin
ADMIN_SECRET_KEY=<generate with: python3 -c "import secrets; print(secrets.token_hex(16))">

# App
ENVIRONMENT=development
PORT=8000
# APP_URL: 브라우저가 접근하는 공개 URL. Google OAuth redirect_uri가 이 값을 쓴다.
#   프로덕션 예시: https://story.onebitebitcoin.com
#   Google Cloud Console에 "{APP_URL}/api/v1/auth/google/callback" 등록 필요
APP_URL=http://localhost:5173
APP_BASE_URL=http://localhost:8000
# LNURL_BASE_URL: 라이트닝 로그인(LNURL-auth) 전용 공개 URL. 비우면 APP_BASE_URL 을 따른다.
#   LUD-04 는 linkingKey 를 HMAC-SHA256(hashingKey, FQDN) 으로 파생한다 — 이 도메인이
#   바뀌면 같은 지갑이 다른 공개키를 만들어 기존 계정에 못 들어오고, 로그인 실패가
#   아니라 빈 새 계정이 조용히 생긴다.
#   서비스 도메인을 옮겨도 이 값은 라이트닝 사용자가 처음 가입한 도메인으로 고정한다.
#   프로덕션 현재값: https://stackhealth.life (서비스는 story.onebitebitcoin.com)
LNURL_BASE_URL=

# Frontend build-time public URL (VITE_ prefix makes it available in browser bundle)
VITE_APP_BASE_URL=http://localhost:5173

# Google OAuth (선택 — 미설정 시 Google 로그인 비활성화)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis (선택 — 미설정 시 백엔드 직접 ffmpeg fallback 사용)
# merge-audio 잡 큐용
REDIS_URL=redis://localhost:6379/0

# Gemini API (선택 — 운동열 필터의 운동 종목 자동 분류용)
# 미설정 시 근육군 프리셋 없이 운동열 렌더 (부위 정확도만 소폭 하락, 정상 동작)
# 설정 시 영상당 1회 분류 호출 (~1.6원/영상). 워커(.env)에 넣어야 적용됨
GEMINI_API_KEY=
